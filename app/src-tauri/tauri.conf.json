{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Offline Library",
  "version": "0.1.0",
  "identifier": "app.offlinelibrary.desktop",
  "build": {
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "app"
    ],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "category": "Reference",
    "shortDescription": "Offline reference library with a local AI assistant",
    "copyright": "All rights reserved",
    "macOS": {
      "signingIdentity": "-",
      "minimumSystemVersion": "12.0"
    }
  }
}
